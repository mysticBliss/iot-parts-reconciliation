# ==============================================================================
# Confluent Cloud & Infrastructure Environment Variables
# ==============================================================================

# --- Confluent Cloud Kafka Cluster ---
CONFLUENT_BOOTSTRAP_SERVERS=pkc-asdasd.region.azure.confluent.cloud:9092
CONFLUENT_API_KEY=CONFLUENT_API_KEY
CONFLUENT_API_SECRET=CONFLUENT_API_SECRET

# --- Confluent Schema Registry ---
SCHEMA_REGISTRY_URL=pkc-sadaw.region.azure.confluent.cloud:9092
SCHEMA_REGISTRY_API_KEY=YOUR_SCHEMA_REGISTRY_API_KEY
SCHEMA_REGISTRY_API_SECRET=YOUR_SCHEMA_REGISTRY_API_SECRET

# --- Local MQTT & Network ---
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- Local PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reconciliation_db
POSTGRES_PORT=5432

# --- Apache Superset ---
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=custom_reconciliation_superset_secret_key_2026_xyz
