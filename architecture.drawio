        <mxCell id="hld-line1" value="&lt;b&gt;Assembly Line 1 (Engine Block)&lt;/b&gt;&lt;br&gt;Devices: &lt;code&gt;pi-01, pi-02, pi-03, pi-04&lt;/code&gt;&lt;br&gt;Output: Optical Sensor Pulse counts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="65" y="160" width="290" height="65" as="geometry" />
        </mxCell>

