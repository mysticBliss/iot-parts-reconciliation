        <!-- TITLE BAR -->
        <mxCell id="hld-title" value="&lt;b style='font-size: 18px;'&gt;IoT Edge-to-Cloud Real-Time Discrepancy Reconciliation Engine&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 12px; color: #555;'&gt;High-Level System Architecture (HLD) — Enterprise Hybrid Event-Driven Stream Processing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;strokeWidth=2;align=left;spacingLeft=20;" vertex="1" parent="1">
