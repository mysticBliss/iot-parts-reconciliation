          <mxGeometry x="65" y="245" width="290" height="65" as="geometry" />
        </mxCell>

        <mxCell id="hld-line3" value="&lt;b&gt;Assembly Line 3 (Final Assembly)&lt;/b&gt;&lt;br&gt;Devices: &lt;code&gt;pi-08, pi-09, pi-10&lt;/code&gt;&lt;br&gt;Output: Laser Inspection Pulse counts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="65" y="330" width="290" height="65" as="geometry" />
        </mxCell>

        <mxCell id="hld-mosquitto" value="&lt;b style='font-size:13px;'&gt;Eclipse Mosquitto Broker&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Port: &lt;b&gt;:1883&lt;/b&gt; (TCP MQTT)&lt;br&gt;• Wildcard Topic: &lt;code&gt;factory/#&lt;/code&gt;&lt;br&gt;• Delivery: &lt;b&gt;QoS 1&lt;/b&gt; (At-Least-Once)&lt;br&gt;• Max In-flight: 1000 msgs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D2E3FC;strokeColor=#185ABC;fontSize=11;spacing=6;" vertex="1" parent="1">
