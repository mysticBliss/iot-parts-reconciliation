  <!-- PAGE 2: LOW-LEVEL ARCHITECTURE (LLD)                                                     -->
  <!-- ========================================================================================= -->
  <diagram id="iot-reconciliation-lld" name="Low-Level Architecture (LLD)">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE BAR -->
        <mxCell id="lld-title" value="&lt;b style='font-size: 18px;'&gt;IoT Edge-to-Cloud Real-Time Discrepancy Reconciliation Engine&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 12px; color: #555;'&gt;Low-Level Technical Architecture (LLD) — Data Schemas, SMT Transforms, Flink SQL Joins &amp; DDL&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#33691E;strokeWidth=2;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1680" height="60" as="geometry" />
        </mxCell>

        <!-- COLUMN 1: Edge Serialization & Topic Routing -->
        <mxCell id="lld-col1" value="1. Edge MQTT Telemetry &amp; Serialization" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=#E8F0FE;strokeColor=#1A73E8;strokeWidth=2;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="370" height="740" as="geometry" />
        </mxCell>

        <mxCell id="lld-card-payload" value="&lt;b&gt;Edge Wire Format (Delimited Token / JSON)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;&amp;lt;device_id&amp;gt;::&amp;lt;line&amp;gt;::&amp;lt;parts&amp;gt;::&amp;lt;status&amp;gt;::&amp;lt;ts&amp;gt;&lt;/code&gt;&lt;br&gt;&lt;br&gt;Example Payload:&lt;br&gt;&lt;code&gt;pi-03::line1::1::RUNNING::2026-09-30T13:00:00Z&lt;/code&gt;&lt;br&gt;&lt;br&gt;• Compact footprint: ~45 bytes/msg&lt;br&gt;• MQTT QoS: 1 (PUBACK required)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;fontSize=11;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="330" height="150" as="geometry" />
        </mxCell>

        <mxCell id="lld-card-routes" value="&lt;b&gt;Mosquitto MQTT Topic Hierarchy&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;factory/lines/line1/machines/pi-01&lt;/code&gt;&lt;br&gt;&lt;code&gt;factory/lines/line1/machines/pi-02&lt;/code&gt;&lt;br&gt;&lt;code&gt;factory/lines/line2/machines/pi-05&lt;/code&gt;&lt;br&gt;&lt;code&gt;factory/lines/line3/machines/pi-08&lt;/code&gt;&lt;br&gt;&lt;br&gt;Wildcard subscription by Connect: &lt;b&gt;&lt;code&gt;factory/#&lt;/code&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;fontSize=11;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="330" height="150" as="geometry" />
        </mxCell>

        <mxCell id="lld-card-avro-schema" value="&lt;b&gt;Avro Schema Contract (`part_event.avsc`)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;pre style='font-size:10px;'&gt;{&#xa;  &quot;type&quot;: &quot;record&quot;,&#xa;  &quot;name&quot;: &quot;PartEvent&quot;,&#xa;  &quot;namespace&quot;: &quot;com.factory.iot&quot;,&#xa;  &quot;fields&quot;: [&#xa;    {&quot;name&quot;: &quot;device_id&quot;, &quot;type&quot;: &quot;string&quot;},&#xa;    {&quot;name&quot;: &quot;line&quot;,      &quot;type&quot;: &quot;string&quot;},&#xa;    {&quot;name&quot;: &quot;parts&quot;,     &quot;type&quot;: &quot;int&quot;},&#xa;    {&quot;name&quot;: &quot;status&quot;,    &quot;type&quot;: &quot;string&quot;},&#xa;    {&quot;name&quot;: &quot;ts&quot;,        &quot;type&quot;: &quot;string&quot;}&#xa;  ]&#xa;}&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A73E8;fontSize=10;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="330" height="220" as="geometry" />
        </mxCell>

        <!-- COLUMN 2: Kafka Connect SMT & Wire Transform -->
        <mxCell id="lld-col2" value="2. Kafka Connect Engine (SMT &amp; Avro Conversion)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=#F1F8E9;strokeColor=#33691E;strokeWidth=2;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="110" width="390" height="740" as="geometry" />
        </mxCell>

        <mxCell id="lld-card-smt" value="&lt;b&gt;Single Message Transform (SMT) Logic&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Step 1: Extract Key from Regex/Topic&lt;/b&gt;&lt;br&gt;Transform: &lt;code&gt;ExtractTopic$Key&lt;/code&gt; extracts &lt;code&gt;device_id&lt;/code&gt; as Kafka message key for partition hash alignment.&lt;br&gt;&lt;br&gt;&lt;b&gt;Step 2: Delimited to Structured Record&lt;/b&gt;&lt;br&gt;Tokenizes payload by &lt;code&gt;::&lt;/code&gt; and binds to Avro schema fields.&lt;br&gt;&lt;br&gt;&lt;b&gt;Step 3: Confluent Schema ID Header Prepending&lt;/b&gt;&lt;br&gt;Wire format: &lt;code&gt;[0x00 (1B)] + [Schema_ID (4B)] + [Avro Payload]&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#33691E;fontSize=11;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="465" y="150" width="340" height="210" as="geometry" />
        </mxCell>

        <mxCell id="lld-card-conn-config" value="&lt;b&gt;Connector JSON Config Snapshot&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code style='font-size:10px;'&gt;&quot;connector.class&quot;: &quot;io.confluent.connect.mqtt.MqttSourceConnector&quot;,&lt;br&gt;&quot;mqtt.server.uris&quot;: &quot;tcp://mosquitto:1883&quot;,&lt;br&gt;&quot;mqtt.topics&quot;: &quot;factory/#&quot;,&lt;br&gt;&quot;kafka.topic&quot;: &quot;device_counts&quot;,&lt;br&gt;&quot;value.converter&quot;: &quot;io.confluent.connect.avro.AvroConverter&quot;,&lt;br&gt;&quot;value.converter.schema.registry.url&quot;: &quot;${SCHEMA_REGISTRY_URL}&quot;,&lt;br&gt;&quot;value.converter.basic.auth.user.info&quot;: &quot;${SR_KEY}:${SR_SECRET}&quot;&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#33691E;fontSize=10;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="465" y="380" width="340" height="190" as="geometry" />
        </mxCell>

        <mxCell id="lld-card-mes-flow" value="&lt;b&gt;MES Cloud Producer Contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Produces directly to topic: &lt;code&gt;system_counts&lt;/code&gt;&lt;br&gt;• SASL_SSL PLAIN Auth&lt;br&gt;• Deliberate anomaly injection (0.15 rate) for test validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#33691E;fontSize=11;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="465" y="590" width="340" height="120" as="geometry" />
        </mxCell>

        <!-- COLUMN 3: Confluent Flink SQL Engine Internals -->
        <mxCell id="lld-col3" value="3. Confluent Flink SQL Engine (Event-Time Window Reconciliation)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=#F3E5F5;strokeColor=#4A148C;strokeWidth=2;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="110" width="460" height="740" as="geometry" />
        </mxCell>

        <mxCell id="lld-card-flink-ddl" value="&lt;b&gt;Flink DDL with Event-Time Watermarks&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;pre style='font-size:10px;'&gt;CREATE TABLE device_counts (&#xa;  device_id STRING,&#xa;  line STRING,&#xa;  parts INT,&#xa;  ts STRING,&#xa;  event_time AS TO_TIMESTAMP_LTZ(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z'''),&#xa;  WATERMARK FOR event_time AS event_time - INTERVAL '5' SECOND&#xa;);&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A148C;fontSize=10;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="880" y="150" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="lld-card-flink-sql" value="&lt;b&gt;Continuous Discrepancy Detection Query&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;pre style='font-size:9.5px;'&gt;INSERT INTO count_mismatches&#xa;SELECT &#xa;    COALESCE(d.window_start, s.window_start) AS window_start,&#xa;    COALESCE(d.window_end, s.window_end) AS window_end,&#xa;    COALESCE(d.device_id, s.device_id) AS device_id,&#xa;    COALESCE(d.total_device_parts, 0) AS device_total,&#xa;    COALESCE(s.total_system_parts, 0) AS system_total,&#xa;    (COALESCE(d.total_device_parts, 0) - COALESCE(s.total_system_parts, 0)) AS discrepancy,&#xa;    CURRENT_TIMESTAMP AS detected_at&#xa;FROM (&#xa;    SELECT window_start, window_end, device_id, SUM(parts) AS total_device_parts&#xa;    FROM TABLE(TUMBLE(TABLE device_counts, DESCRIPTOR(event_time), INTERVAL '1' MINUTE))&#xa;    GROUP BY window_start, window_end, device_id&#xa;) d&#xa;FULL OUTER JOIN (&#xa;    SELECT window_start, window_end, device_id, SUM(parts) AS total_system_parts&#xa;    FROM TABLE(TUMBLE(TABLE system_counts, DESCRIPTOR(event_time), INTERVAL '1' MINUTE))&#xa;    GROUP BY window_start, window_end, device_id&#xa;) s&#xa;ON d.window_start = s.window_start AND d.device_id = s.device_id&#xa;WHERE COALESCE(d.total_device_parts, 0) &lt;&gt; COALESCE(s.total_system_parts, 0);&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A148C;fontSize=9.5;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="880" y="320" width="420" height="390" as="geometry" />
        </mxCell>

        <!-- COLUMN 4: Persistence Schema & Superset Queries -->
        <mxCell id="lld-col4" value="4. PostgreSQL Schema &amp; Superset Analytics" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=2;align=left;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1350" y="110" width="370" height="740" as="geometry" />
        </mxCell>

        <mxCell id="lld-card-pg-ddl" value="&lt;b&gt;PostgreSQL DDL (`init.sql`)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;pre style='font-size:10px;'&gt;CREATE TABLE count_mismatches (&#xa;    id SERIAL PRIMARY KEY,&#xa;    window_start TIMESTAMP NOT NULL,&#xa;    window_end TIMESTAMP,&#xa;    device_id VARCHAR(50) NOT NULL,&#xa;    device_total INTEGER NOT NULL,&#xa;    system_total INTEGER NOT NULL,&#xa;    discrepancy INTEGER NOT NULL,&#xa;    detected_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP&#xa;);&#xa;&#xa;CREATE INDEX idx_mismatches_device &#xa;    ON count_mismatches(device_id);&#xa;CREATE INDEX idx_mismatches_window &#xa;    ON count_mismatches(window_start);&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=10;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="1370" y="150" width="330" height="230" as="geometry" />
        </mxCell>

        <mxCell id="lld-card-analytics" value="&lt;b&gt;Key Operational SQL Metrics&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Sensor Dropped Pulses vs Bounce:&lt;/b&gt;&lt;br&gt;&lt;pre style='font-size:9.5px;'&gt;SELECT &#xa;  device_id,&#xa;  COUNT(CASE WHEN discrepancy &gt; 0 THEN 1 END) AS over_counts,&#xa;  COUNT(CASE WHEN discrepancy &lt; 0 THEN 1 END) AS dropped_pulses,&#xa;  AVG(ABS(discrepancy)) AS avg_drift&#xa;FROM count_mismatches GROUP BY device_id;&lt;/pre&gt;&lt;br&gt;&lt;b&gt;2. Shift Drift Aggregate:&lt;/b&gt;&lt;br&gt;&lt;pre style='font-size:9.5px;'&gt;SELECT DATE_TRUNC('hour', window_start) AS hr,&#xa;       SUM(ABS(discrepancy)) AS total_drift&#xa;FROM count_mismatches GROUP BY hr ORDER BY hr;&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;fontSize=10;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="1370" y="400" width="330" height="310" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
