        <mxCell id="hld-topic-dev" value="&lt;b&gt;Topic: `device_counts`&lt;/b&gt;&lt;br&gt;• 3 Partitions | Key: &lt;code&gt;device_id&lt;/code&gt;&lt;br&gt;• Format: &lt;b&gt;Avro Binary&lt;/b&gt; + Schema ID&lt;br&gt;• Retention: 7 Days" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;spacing=4;align=left;" vertex="1" parent="1">
